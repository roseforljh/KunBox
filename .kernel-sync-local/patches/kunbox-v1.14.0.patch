+			budgetedWireGuardBind: base,
+			peek:                  peek,
+			interfaceBind:         interfaceBind,
+		}
+	case hasPeek:
+		return &budgetedWireGuardPeekBind{budgetedWireGuardBind: base, peek: peek}
+	case hasInterfaceBind:
+		return &budgetedWireGuardInterfaceBind{
+			budgetedWireGuardBind: base,
+			interfaceBind:         interfaceBind,
+		}
+	default:
+		return base
+	}
+}
