+	group, isGroup := outbound.(adapter.OutboundGroup)
+	if !isGroup {
+		return C.IsRemoteProxyType(outbound.Type())
+	}
+	tag := outbound.Tag()
+	if tag == "" || visiting[tag] {
+		return false
+	}
+	children := group.All()
+	if len(children) == 0 {
+		return false
+	}
+	visiting[tag] = true
+	defer delete(visiting, tag)
+	for _, childTag := range children {
+		child, loaded := lookup(childTag)
+		if !loaded || !isKunBoxRemoteOnlyOutbound0(child, lookup, visiting) {
+			return false
+		}
+	}
+	return true
+}
