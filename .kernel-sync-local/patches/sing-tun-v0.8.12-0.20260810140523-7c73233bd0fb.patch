+			defer func() {
+				if panicValue := recover(); panicValue != nil {
+					_ = connection.Close()
+					panic(panicValue)
+				}
+			}()
+			s.handler.NewConnectionEx(
+				s.ctx,
+				connection,
+				M.SocksaddrFromNetIP(connectionSession.Source),
+				M.SocksaddrFromNetIP(connectionSession.Destination),
+				N.OnceClose(func(error) { _ = connection.Close() }),
+			)
+		}(trackedConnection, session)
