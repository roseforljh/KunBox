+				s.logger.Error(E.Cause(err, "accept system TCP connection"))
+				return
+			}
+			nextDelay := 5 * time.Millisecond
+			if retryDelay > 0 {
+				nextDelay = min(retryDelay*2, time.Second)
+			}
+			if nextDelay != retryDelay {
+				s.logger.Warn("accept system TCP connection: ", err, ", retrying in ", nextDelay)
+			}
+			retryDelay = nextDelay
+			select {
+			case <-time.After(retryDelay):
+				continue
