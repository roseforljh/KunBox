+func (m *ConnectionManager) acquirePacketConnection(ctx context.Context) bool {
+	select {
+	case m.packetConnectionSlots <- struct{}{}:
+		return true
+	case <-ctx.Done():
+		return false
+	}
+}
+
+func newPacketDialContext(parent context.Context, conn N.PacketConn) (context.Context, context.CancelFunc) {
+	timeoutConn, loaded := common.Cast[canceler.PacketConn](conn)
+	if !loaded {
+		return parent, func() {}
+	}
+	dialContext, cancel := context.WithCancel(parent)
+	if timeoutConn.Timeout() <= 0 {
+		cancel()
+		return dialContext, cancel
+	}
+	go func() {
+		// ponytail: 旧版 udpnat2 没有关闭通知，仅在拨号期间轮询；迁移到新版 sing-tun UDPNAT 后删除。
+		ticker := time.NewTicker(10 * time.Millisecond)
+		defer ticker.Stop()
+		for {
+			select {
+			case <-dialContext.Done():
+				return
+			case <-ticker.C:
+				if timeoutConn.Timeout() <= 0 {
+					cancel()
+					return
+				}
+			}
+		}
+	}()
+	return dialContext, cancel
 }
 
