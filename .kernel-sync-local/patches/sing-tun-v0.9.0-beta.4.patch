+func (s *System) trackTCPConnection(conn net.Conn) *systemTCPConnection {
+	trackedConnection := &systemTCPConnection{Conn: conn, owner: s}
+	s.tcpConnectionAccess.Lock()
+	if s.closed {
+		s.tcpConnectionAccess.Unlock()
+		return nil
+	}
+	if s.tcpConnections == nil {
+		s.tcpConnections = make(map[*systemTCPConnection]struct{})
+	}
+	limit := s.tcpConnectionLimit
+	if limit <= 0 {
+		limit = systemTCPConnectionLimit
+	}
+	if len(s.tcpConnections) >= limit {
+		s.tcpRejected++
+		rejected := s.tcpRejected
+		shouldLog := s.tcpLastRejectLog.IsZero() || time.Since(s.tcpLastRejectLog) >= systemTCPRejectionLogInterval
+		if shouldLog {
+			s.tcpLastRejectLog = time.Now()
+		}
+		active := len(s.tcpConnections)
+		s.tcpConnectionAccess.Unlock()
+		if shouldLog {
+			s.logTCPConnectionRejection(conn, active, limit, rejected)
+		}
+		return nil
+	}
+	s.tcpConnections[trackedConnection] = struct{}{}
+	s.tcpConnectionAccess.Unlock()
+	return trackedConnection
+}
